<ruleset xmlns="http://codenarc.org/ruleset/1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://codenarc.org/ruleset/1.0 http://codenarc.org/ruleset-schema.xsd"
         xsi:noNamespaceSchemaLocation="http://codenarc.org/ruleset-schema.xsd">

    <description>Regras do CodeNarc para o Linketinder-Spring</description>

    <ruleset-ref path="rulesets/basic.xml"/>
    <ruleset-ref path="rulesets/exceptions.xml"/>
    <ruleset-ref path="rulesets/imports.xml"/>
    <ruleset-ref path="rulesets/formatting.xml">
        <rule-config name="Indentation">
            <property name="enabled" value="false" />
        </rule-config>
        <rule-config name="TrailingWhitespace">
            <property name="enabled" value="false" />
        </rule-config>
        <rule-config name="SpaceAroundMapEntryColon">
            <property name="enabled" value="false" />
        </rule-config>
        <rule-config name="LineLength">
            <property name="length" value="200" />
        </rule-config>
        <rule-config name="ClassEndsWithBlankLine">
            <property name="enabled" value="false" />
        </rule-config>
        <rule-config name="MissingBlankLineBeforeAnnotatedField">
            <property name="enabled" value="false" />
        </rule-config>
        <rule-config name="SpaceBeforeClosingBrace">
            <property name="enabled" value="false" />
        </rule-config>
        <rule-config name="SpaceAfterOpeningBrace">
            <property name="enabled" value="false" />
        </rule-config>
        <rule-config name="SpaceBeforeOpeningBrace">
            <property name="enabled" value="false" />
        </rule-config>
    </ruleset-ref>
    <ruleset-ref path="rulesets/unused.xml"/>
</ruleset>
